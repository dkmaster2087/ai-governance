# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# CDK
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# Gateway
PORT=3000
STAGE=dev
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Local only: accept `Bearer test-key` + x-dev-role so the dashboard demo accounts work.
# Refused at startup unless STAGE is dev/local/test.
AUTH_DEV_MODE=true
# Dashboard sign-in (from the auth stack outputs). Leave unset locally to use demo accounts.
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# What to do if the policy engine / PII service is down: closed (block, default) or open (allow + flag in audit)
GOVERNANCE_FAIL_MODE=closed
# Secrets Manager name prefix for customers' provider API keys
PROVIDER_KEYS_SECRET_PREFIX=aegis/dev/provider-keys

# Policy Engine
POLICY_ENGINE_URL=http://localhost:3001

# Data Protection
DATA_PROTECTION_URL=http://localhost:3002
COMPREHEND_ENABLED=false

# Storage
AUDIT_LOG_BUCKET=ai-governance-audit-logs-dev
POLICIES_TABLE=ai-gov-policies-dev
METRICS_TABLE=ai-gov-metrics-dev

# AI Providers
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Analytics
ATHENA_DATABASE=ai_gov_logs_dev
ATHENA_OUTPUT_BUCKET=s3://ai-gov-athena-results-dev/
