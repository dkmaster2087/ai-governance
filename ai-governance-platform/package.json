{
  "name": "ai-governance-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/*",
    "frontend/*",
    "infra",
    "shared/*",
    "collector",
    "connector",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "test:e2e": "npm run build -w shared/catalog -w collector -w packages/verify-identity && node --test --test-concurrency=1 tests/e2e/request-path.test.mjs tests/e2e/log-export.test.mjs tests/e2e/enforcement.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^20.0.0",
    "bytenode": "^1.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
