# For docker compose itself (copy to .env). The gateway's own settings are in probaline.env.
PROBALINE_IMAGE=registry.example.com/probaline:1.0.0
# The database password: make one with  openssl rand -hex 24
POSTGRES_PASSWORD=
# Port on this host for the gateway (behind your HTTPS proxy).
PROBALINE_PORT=3000
# For the https profile: the gateway's address, as in the license.
PROBALINE_ADDRESS=ai-gateway.customer.com
# file (default, this host's disk), s3 (any S3-compatible store; see docs/INSTALL.md) or none.
OBJECT_STORE=file
