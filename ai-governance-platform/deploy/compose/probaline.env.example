# Probaline's settings (copy to probaline.env). Every setting: docs/INSTALL.md.

# ── Required ──────────────────────────────────────────────────────────────────────────────────────────────────
# The address people and apps use, with https://. It must match the license.
PUBLIC_GATEWAY_URL=https://ai-gateway.customer.com
# Encrypts provider keys and other secrets in the database: make one with  openssl rand -base64 32
# Keep a copy safe: without it, saved provider keys can't be read.
SECRETS_ENCRYPTION_KEY=

# ── First start ───────────────────────────────────────────────────────────────────────────────────────────────
PROBALINE_COMPANY_NAME=Customer Inc
PROBALINE_ADMIN_EMAIL=security@customer.com
# Optional: a temporary password for the first admin (12+ characters, mixed case, a number, a symbol). Without
# it, one is made and written once to the gateway's log:  docker compose logs probaline | grep "first admin"
PROBALINE_ADMIN_PASSWORD=

# ── License ───────────────────────────────────────────────────────────────────────────────────────────────────
# The license file's text (PBL1.…). Or leave empty and enter it on the License page; the install works for 30 days
# without one.
PROBALINE_LICENSE=

# ── Company sign-in (optional) ────────────────────────────────────────────────────────────────────────────────
# OIDC: Entra ID, Okta, Google… Redirect URI to register: <PUBLIC_GATEWAY_URL>/v1/auth/sso/callback
PROBALINE_SSO_NAME=
PROBALINE_SSO_ISSUER=
PROBALINE_SSO_CLIENT_ID=
PROBALINE_SSO_CLIENT_SECRET=

# ── Email (optional): alerts and license notices, through your own mail server ──────────────────────────────
# Exchange, a Microsoft 365 or Google Workspace relay, Postfix, SendGrid… STARTTLS on 587 unless SMTP_TLS=tls (465).
# The connection is always encrypted and the server's certificate checked; for a certificate from your own CA,
# put the CA's PEM text in SMTP_CA.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Probaline <probaline@customer.com>
SMTP_USER=
SMTP_PASSWORD=
# SMTP_TLS=tls
# SMTP_CA=

# ── Optional ──────────────────────────────────────────────────────────────────────────────────────────────────
# For OBJECT_STORE=s3: the bucket, and the endpoint of an S3-compatible store (MinIO, Ceph…), with its keys.
# AUDIT_LOG_BUCKET=probaline-archive
# S3_ENDPOINT=https://minio.internal:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
